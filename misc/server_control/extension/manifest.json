{
  "manifest_version": 3,
  "name": "AREQA Server Control",
  "version": "0.1.0",
  "description": "Control the AREQA backend and frontend Render services through the server-control Worker.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AREQA Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.workers.dev/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
